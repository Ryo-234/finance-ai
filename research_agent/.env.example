MODEL_PROVIDER=minimax
MINIMAX_DEFAULT_MODEL=MiniMax-M2.7-highspeed

# 支付宝沙箱配置（密钥存在 data/ 下的 .pem 文件，避免 .env 多行问题）
ALIPAY_DEBUG=true
ALIPAY_APPID=你的沙箱APPID（控制台 -> 沙箱应用 -> APPID）
ALIPAY_PRIVATE_KEY_PATH=./data/alipay_app_private_key.pem  # 你的 RSA 私钥（PEM 格式）
ALIPAY_PUBLIC_KEY_PATH=./data/alipay_public_key.pem  # 支付宝公钥（PEM 格式）
ALIPAY_NOTIFY_URL=https://你的公网域名/api/billing/callback/alipay
ALIPAY_RETURN_URL=https://你的公网域名/billing/orders

# 管理员邮箱白名单（逗号分隔，访问 /api/admin/billing 时校验）
ADMIN_EMAILS=


# 密钥生成方法（沙箱自定义密钥模式）：
# 1. openssl genrsa -out app_private_key.pem 2048
# 2. openssl rsa -in app_private_key.pem -pubout -out app_public_key.pem
# 3. 把 app_public_key.pem 内容粘贴到沙箱应用公钥输入框
# 4. 沙箱自动生成支付宝公钥，保存到 data/alipay_public_key.pem
# 5. 把 ALIPAY_NOTIFY_URL/RETURN_URL 改成你的公网 URL
