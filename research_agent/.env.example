# ===== LLM API Keys =====
DASHSCOPE_API_KEY=sk-你的key
TAVILY_API_KEY=tvly-你的key
MINIMAX_API_KEY=sk-cp-你的key
MODEL_PROVIDER=minimax
MINIMAX_DEFAULT_MODEL=MiniMax-M2.7-highspeed

# ===== 数据库 =====
# 开发：留空（用 SQLite ./data/finance_agent.db）
# 生产：填 PostgreSQL 连接字符串（Render 自动注入 DATABASE_URL）
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ===== 支付宝沙箱配置 =====
ALIPAY_DEBUG=true
ALIPAY_APPID=你的沙箱APPID

# 密钥两种方式（二选一）：
# 方式 1（开发）：用 .pem 文件路径
ALIPAY_PRIVATE_KEY_PATH=./data/alipay_app_private_key.pem
ALIPAY_PUBLIC_KEY_PATH=./data/alipay_public_key.pem

# 方式 2（生产/PaaS）：把 PEM 内容直接放环境变量
# ALIPAY_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
# ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# 回调地址（生产必须 HTTPS）
ALIPAY_NOTIFY_URL=https://你的公网域名/api/billing/callback/alipay
ALIPAY_RETURN_URL=https://你的公网域名/billing/orders

# ===== 管理员白名单 =====
ADMIN_EMAILS=你的邮箱@example.com


# ====== 部署到 Render/Vercel 需要的全部环境变量 ======
# Render 后端服务需要：
#   ALIPAY_APP_PRIVATE_KEY     (PEM 内容，多行)
#   ALIPAY_PUBLIC_KEY          (PEM 内容，多行)
#   ALIPAY_NOTIFY_URL          (https://research-agent-api.onrender.com/api/billing/callback/alipay)
#   ALIPAY_RETURN_URL          (https://research-agent-web.vercel.app/billing/orders)
#   DASHSCOPE_API_KEY
#   TAVILY_API_KEY
#   MINIMAX_API_KEY
#   ADMIN_EMAILS
#   DATABASE_URL               (Render 自动注入，不用手动配)

# Vercel 前端服务需要：
#   NEXT_PUBLIC_API_BASE_URL   (https://research-agent-api.onrender.com)


# ====== 密钥生成（沙箱"自定义密钥"模式）======
# 1. openssl genrsa -out app_private_key.pem 2048
# 2. openssl rsa -in app_private_key.pem -pubout -out app_public_key.pem
# 3. 把 app_public_key.pem 内容粘贴到沙箱"应用公钥"输入框
# 4. 沙箱自动生成"支付宝公钥"，保存到 data/alipay_public_key.pem
# 5. 把 ALIPAY_NOTIFY_URL/RETURN_URL 改成你的公网 URL
